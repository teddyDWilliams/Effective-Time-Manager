@page "/EnterEvent"
@rendermode InteractiveServer

<h3>Create Event (@events.Count)</h3>

<label>Title:</label>
<input @bind="title" />
<button @onclick="addTitle" >Next</button>

@if (!string.IsNullOrWhiteSpace(confirmedTitle))
{
    <label>Day:</label>
    <input @bind="Day" />
    <button @onclick="addDay">Next</button>
}

@if(day > 0)
{
    <label>Month:</label>
    <input @bind="Month" />
    
    <label> Recurring Days: </label>
    <input @bind="rC" />
    <button @onclick="addMonth">Next</button>
}



@if(month > 0)
{
    <label>Year:</label>
    <input @bind="Year" />
    <button @onclick="addYear">Next</button>
    

}

@if(year > 0)
{
    <label>Start Time</label>
    <input @bind="sH" />
    <span><strong>:</strong></span>
    <input @bind="sM" />
    <button @onclick="addStartTime">Next</button>
}

@if(year > 0 && startHour >= 0 && startMinute >= 0 && startHour <= 23 && startMinute <= 59)
{
    <label>End Time</label>
    <input @bind="eH" />
    <span><strong>:</strong></span>
    <input @bind="eM" />
    <button @onclick="addEndTime">Next</button>
}

@if(year > 0 && endHour >= 0 && endMinute >= 0 && endHour <= 23 && endMinute <= 59)
{
    <button @onclick="addEvent">Add Event</button>
}



<h3>Events:</h3>

@if (events.Count == 0)
{
    <p>No events yet.</p>
}
else
{
    <ul>
        @foreach (var e in events)
        {
            <li>
                <input type="checkbox" @bind="e.IsDone" />
                
                @e.title - @e.m @e.day, @e.year from @e.startDate.Hour:@e.startDate.Minute to @e.endDate.Hour:@e.endDate.Minute | 
                <p>The event is @e.timeUntil.Days days, @e.timeUntil.Hours hours, and @e.timeUntil.Minutes minutes away from now.</p>
                <!-- @e.eventDuration.Hours hours and @e.eventDuration.Minutes minutes long -->
            </li>
        }
    </ul>
}

@code {

    @using System
    @using System.Collections
    private List<CreateEvent> events = new();

    string title = "";
    string confirmedTitle = "";
    string Day = "";
    int day = 0;
    string Month = "";
    int month = 0;
    string Year = "";
    int year = 0;
    string sH = "";
    string sM = "";
    string eH = "";
    string eM = "";
    int startHour = -1;
    int startMinute = -1;
    int endHour = -1;
    int endMinute = -1;
    string rC = "";
    BitArray daysOfWeek = new BitArray(7,false);

    void addTitle()
    {
        if (!string.IsNullOrWhiteSpace(title))
        {
            confirmedTitle = title;
            title = string.Empty;
        }
    }

    void addDay()
    {
        if (int.TryParse(Day, out day) && day >= 1 && day <= 31)
        {
            Day = "";
        }
    }

    void addRecurring()
    {
        daysOfWeek.SetAll(false);

        if(!string.IsNullOrWhiteSpace(rC))
        {
            if(rC.Contains("Monday") || rC.Contains("monday"))
            {
                daysOfWeek[0] = true;
            }else if(rC.Contains("tuesday") || rC.Contains("Tuesday"))
            {
                daysOfWeek[1] = true;
            }else if(rC.Contains("Wednesday") || rC.Contains("wednesday"))
            {
                daysOfWeek[2] = true;
            }else if(rC.Contains("Thursday") || rC.Contains("thursday"))
            {
                daysOfWeek[3] = true;
            }else if(rC.Contains("Friday") || rC.Contains("friday"))
            {
                daysOfWeek[4] = true;
            }else if(rC.Contains("Saturday") || rC.Contains("saturday"))
            {
                daysOfWeek[5] = true;
            }else if(rC.Contains("Sunday") || rC.Contains("sunday"))
            {
                daysOfWeek[6] = true;
            }
        }
    }

    void addMonth()
    {
        if (int.TryParse(Month, out month) && month >= 1 && month <= 12)
        {
            Month = "";
        }
    }

    void addYear()
    {
        if(int.TryParse(Year,out year) && year >= 2025)
        {
            Year = "";
        }
    }

    void addStartTime()
    {
        if(int.TryParse(sH,out startHour) && startHour >= 0 && startHour <= 23)
        {
            sH = "";
            if(startHour > 12){
                startHour = startHour - 12;
            }
        }
        if(int.TryParse(sM,out startMinute) && startMinute >= 0 && startMinute <= 59)
        {
            sM = "";
        }
    }

    void addEndTime()
    {
        if(int.TryParse(eH,out endHour) && endHour >= 0 && endHour <= 23)
        {
            eH = "";
            if(endHour > 12){
                endHour = endHour - 12;
            }
        }
        if(int.TryParse(eM,out endMinute) && endMinute >= 0 && endMinute <= 59)
        {
            eM = "";
        }
    }

    void addEvent()
    {
            events.Add(new CreateEvent
            (
                confirmedTitle,
                day,
                month,
                year,
                startHour,
                startMinute,
                endHour,
                endMinute
            ));
            title = "";
            confirmedTitle = "";
            day = 0;
            month = 0;
            year = 0;
            startHour = -1;
            startMinute = -1;
            endHour = -1;
            endMinute = -1;
    }

    void userContinue(KeyboardEventArgs e)
    {
        if(e.Code == "Enter")
        {
            addTitle();
        }
    }
}

    
